echo "Building static fallback for GitHub Pages..."
npm run build

remote_url=$(git remote get-url origin)
tmp=$(mktemp -d)
cp -r dist/* "$tmp"
touch "$tmp/.nojekyll"
cd "$tmp"
git init -q
cp "$OLDPWD/GITHUB_PAGES_CNAME" CNAME
git add -A
git commit -q -m "Static fallback deploy"
git push -f "$remote_url" HEAD:gh-pages
rm -rf "$tmp"

echo "GitHub Pages fallback deployed."
