---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAll, ofMonth, getFirst } from '../../lib/incidents';
import type { Incident } from '../../lib/incidents';
import { renderMarkdown } from '../../lib/markdown';
import { sectionLink } from '../../lib/sectionAnchor';
import {
  monthsBetween,
  startOfUtcMonth,
  subUtcMonths,
  timeHtml,
  utcMonthStamp,
} from '../../lib/time';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allIncidents = await getAll();
  const first = getFirst(allIncidents);

  const monthsPerPage = 3;
  const totalPages = Math.max(
    4,
    first ? Math.ceil(monthsBetween(first.date, new Date()) / monthsPerPage) : 4,
  );

  const paths = [];

  for (let i = 0; i < totalPages; i++) {
    const incidentsByMonth = [];

    for (let j = 0; j < monthsPerPage; j++) {
      const month = subUtcMonths(startOfUtcMonth(new Date()), i * monthsPerPage + j);
      const monthIncidents = ofMonth(allIncidents, month).filter(
        (inc) => inc.status !== 'scheduled',
      );

      incidentsByMonth.push({ month, incidents: monthIncidents });
    }

    const nextPath =
      i === 0 ? null : i === 1 ? '/history' : `/history/page/${i - 1}`;
    const prevPath =
      i === totalPages - 1 ? null : `/history/page/${i + 1}`;

    paths.push({
      params: { page: i === 0 ? undefined : `page/${i}` },
      props: { incidentsByMonth, nextPath, prevPath },
    });
  }

  return paths;
};

type Props = {
  incidentsByMonth: { month: Date; incidents: Incident[] }[];
  nextPath: string | null;
  prevPath: string | null;
};

const { incidentsByMonth, nextPath, prevPath } = Astro.props;
---

<BaseLayout title="Incident History - DatoCMS Status">
  <div class="page-container">
    <Header isPageTitle pageName="Incident History" />
    <div class="history">
      <div class="history__header">
        <p class="section-hint"><time-mode-hint>Dates &amp; times in UTC.</time-mode-hint></p>
        <div class="history__header__nav">
          {prevPath && (
            <a href={prevPath} class="history__button history__button--prev">
              <img src="/cheveron-left.svg" alt="Previous" />
            </a>
          )}
          <span>
            <Fragment set:html={timeHtml('month', incidentsByMonth[0].month)} /> to{' '}
            <Fragment set:html={timeHtml('month', incidentsByMonth[incidentsByMonth.length - 1].month)} />
          </span>
          {nextPath && (
            <a href={nextPath} class="history__button history__button--next">
              <img src="/cheveron-right.svg" alt="Next" />
            </a>
          )}
        </div>
      </div>
      {incidentsByMonth.map(({ month, incidents }) => (
        <div class="history__month" id={`month-${utcMonthStamp(month)}`}>
          <h2
            class="history__month__title section-title"
            set:html={sectionLink(`month-${utcMonthStamp(month)}`, timeHtml('month', month))}
          />
          <div>
            {incidents.length === 0 ? (
              <p class="history__month__no-incidents">No incidents reported.</p>
            ) : (
              incidents.map((incident) => (
                <div
                  class={`history__incident history__incident--impact-${incident.impact}`}
                >
                  <h3 class="history__incident__title">
                    <a href={`/incidents/${incident.slug}/`}>
                      {incident.name}
                    </a>
                  </h3>
                  <div class="history__incident__body">
                    <div class="ugc" set:html={renderMarkdown(incident.lastUpdate.content)} />
                    <div class="history__incident__timestamp">
                      <Fragment set:html={timeHtml('date-time', incident.firstUpdate.date)} />
                      {' - '}
                      <Fragment set:html={timeHtml('timestamp', incident.lastUpdate.date)} />
                      <relative-time datetime={incident.lastUpdate.date.toISOString()}></relative-time>
                    </div>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      ))}
    </div>
    <Footer linkLabel="Back to status page" linkUrl="/" />
  </div>
</BaseLayout>
