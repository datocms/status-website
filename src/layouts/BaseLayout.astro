---
import RelativeTime from '../components/RelativeTime.astro';
import TimeMode from '../components/TimeMode.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f5ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100d1a" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <!-- www.datocms.com serves the brand fonts. The licence of ABC Oracle does
         not let us keep a copy in this repository. -->
    <link rel="preconnect" href="https://www.datocms.com" crossorigin />
    <link
      rel="preload"
      href="https://www.datocms.com/fonts/ABCOracleVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DatoCMS Status - RSS"
      href="/history.rss"
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="DatoCMS Status - Atom"
      href="/history.atom"
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="DatoCMS Status - JSON feed"
      href="/history.json"
    />
  </head>
  <body>
    <slot />
    <RelativeTime />
    <TimeMode />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
