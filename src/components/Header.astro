---
import Icon from './Icon.astro';
import type { FaceName } from '../lib/heroHeadline';

interface Props {
  /** The header is the main heading of a page that has no other title. */
  isPageTitle?: boolean;
  /** The name of the page, which comes after the name of the site. */
  pageName?: string;
  /** The claim of the two-tone headline below the header (the homepage). */
  headline?: string;
  /** The quiet run of the headline. */
  headlineMuted?: string;
  /** The text face at the end of the quiet run. */
  headlineFace?: FaceName;
}

const { isPageTitle = false, pageName, headline, headlineMuted, headlineFace } = Astro.props;
const Name = isPageTitle ? 'h1' : 'div';
// The parts are flex items, and a screen reader would put a space before the colon.
const label = pageName ? `DatoCMS Status: ${pageName}` : undefined;
---

<!-- The hero band: the accent of the page theme, full width. The header
     runs into it, as on www.datocms.com. -->
<header class="hero">
  <div class="page-container">
    <div class="page-header">
      <Name class="page-header__logo" aria-label={label}>
        <span class="page-header__site">
          <a href="/">
            <picture>
              <source srcset="/logo-icon-dark.svg" media="(prefers-color-scheme: dark)" />
              <img src="/logo-icon.svg" alt="" />
            </picture>
            <span class="page-header__name">DatoCMS Status</span>
          </a>
          {pageName && <span class="page-header__page">:</span>}
        </span>
        {pageName && <Fragment>{' '}<span class="page-header__page">{pageName}</span></Fragment>}
      </Name>
      <div class="page-header__subscribe">
        <subscribe-modal>
          <div class="subscribe">
            <button class="subscribe__button">
              <Icon name="rss" />
              Subscribe to updates
            </button>
          </div>
        </subscribe-modal>
      </div>
    </div>
    {headline && (
      <p class="hero__headline">
        {headline}
        {headlineMuted && ' '}
        {headlineMuted && (
          <span class="hero__muted">
            {headlineMuted}
            {/* A no-break space joins the face to the last word. */}
            {headlineFace && <Fragment>&nbsp;<span class={`face face--${headlineFace}`} aria-hidden="true"></span></Fragment>}
          </span>
        )}
      </p>
    )}
  </div>
</header>

<script>
  class SubscribeModal extends HTMLElement {
    private modal: HTMLUListElement | null = null;
    private closeHandler = (e: MouseEvent) => {
      if (!this.contains(e.target as Node)) {
        this.close();
      }
    };

    connectedCallback() {
      this.querySelector('.subscribe__button')!.addEventListener('click', () => {
        if (this.modal) {
          this.close();
        } else {
          this.open();
        }
      });
    }

    private open() {
      this.modal = document.createElement('ul');
      this.modal.className = 'subscribe__modal';
      this.modal.innerHTML = `
        <li><a href="/history.atom" target="_blank" rel="noreferrer">Atom feed</a></li>
        <li><a href="/history.rss" target="_blank" rel="noreferrer">RSS feed</a></li>
        <li><a href="/history.json" target="_blank" rel="noreferrer">JSON feed</a></li>
      `;
      this.querySelector('.subscribe')!.appendChild(this.modal);
      document.addEventListener('mousedown', this.closeHandler);
    }

    private close() {
      this.modal?.remove();
      this.modal = null;
      document.removeEventListener('mousedown', this.closeHandler);
    }

    disconnectedCallback() {
      document.removeEventListener('mousedown', this.closeHandler);
    }
  }

  customElements.define('subscribe-modal', SubscribeModal);
</script>
