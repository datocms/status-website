---
interface Props {
  days: number;
}

const { days } = Astro.props;
---

<component-status-section data-days={days}></component-status-section>

<script>
  import { format, subDays, formatDistanceStrict, addSeconds } from 'date-fns';
  import i18n from '../lib/i18n';

  interface Region {
    id: string;
    status: string;
    outagesPerDay: { date: string; downtime: number }[];
  }

  interface ComponentData {
    id: string;
    status: string;
    regions: Region[];
    totalDowntime: number;
  }

  function generateDatesSince(days: number): Date[] {
    const dates: Date[] = [];
    for (let i = 0; i < days; i++) {
      dates.push(subDays(new Date(), days - i - 1));
    }
    return dates;
  }

  function downtimePerRegion(
    regions: Pick<Region, 'id' | 'outagesPerDay'>[],
    date: Date,
  ) {
    return regions.map(({ id, outagesPerDay }) => {
      const day = outagesPerDay.find(
        ({ date: d }) => d === format(date, 'yyyy-MM-dd'),
      );
      return { id, downtime: day ? day.downtime : 0 };
    });
  }

  function totalDowntime(perRegion: { id: string; downtime: number }[]) {
    return perRegion.reduce((acc, { downtime }) => acc + downtime, 0);
  }

  function renderTooltip(
    date: Date,
    perRegion: { id: string; downtime: number }[],
    total: number,
  ): string {
    let content = '';

    if (total === 0) {
      content = '<p>No downtime reported for this day</p>';
    } else if (perRegion.length > 1) {
      content = perRegion
        .filter(({ downtime }) => downtime > 0)
        .map(
          ({ id, downtime }) =>
            `<p class="daily-outage-tooltip-content-region">${formatDistanceStrict(new Date(), addSeconds(new Date(), downtime))} of outage in ${i18n[`region.${id}`]}</p>`,
        )
        .join('');
    } else {
      content = `<p>${formatDistanceStrict(new Date(), addSeconds(new Date(), perRegion[0].downtime))} of outage</p>`;
    }

    return `
      <div class="daily-outage-tooltip-date">${format(date, 'MMMM d')} UTC</div>
      <div class="daily-outage-tooltip-content">${content}</div>
    `;
  }

  function renderOutageBars(
    regions: Region[],
    daysSince: number,
    noData: boolean,
  ): string {
    const dates = generateDatesSince(daysSince);
    const rects = dates
      .map((date, i) => {
        const perRegion = downtimePerRegion(
          noData ? [{ id: 'placeholder', outagesPerDay: [] }] : regions,
          date,
        );
        const total = totalDowntime(perRegion);
        const fill = noData ? '#eee' : total > 0 ? '#f1c40f' : '#2fcc66';

        return `<rect height="34" width="7" x="${8 * i}" y="0" style="transition: fill ease-in-out 0.5s" fill="${fill}" data-index="${i}" data-date="${date.toISOString()}" />`;
      })
      .join('');

    return `
      <div class="daily-outage">
        <svg preserveAspectRatio="none" height="34" viewBox="0 0 ${8 * daysSince - 2} 34">${rects}</svg>
      </div>
    `;
  }

  function renderCard(
    component: ComponentData | null,
    daysSince: number,
  ): string {
    const loading = !component;
    const regions = component?.regions || [];

    // A region is `unknown` when StatusCake did not give its data. Such a
    // region is not an outage, and it gives no uptime value.
    const unknownRegions = regions.filter((r) => r.status === 'unknown');
    const problematicRegions = regions.filter(
      (r) => r.status !== 'up' && r.status !== 'unknown',
    );
    const noData =
      loading || (regions.length > 0 && unknownRegions.length === regions.length);

    let status: string;

    if (problematicRegions.length > 0) {
      status = 'down';
    } else if (noData && !loading) {
      status = 'unknown';
    } else {
      status = 'operational';
    }

    const periodInMs = daysSince * 60 * 60 * 24;
    const componentTotalDowntime = component?.totalDowntime || 0;

    const uptimePercent =
      Math.round(
        ((periodInMs - componentTotalDowntime) / periodInMs) * 100000,
      ) / 1000;

    let uptimeLabel: string;

    if (loading) {
      uptimeLabel = 'Loading...';
    } else if (noData) {
      uptimeLabel = 'No data';
    } else {
      uptimeLabel = `${uptimePercent}%&nbsp;uptime`;
    }

    // Some regions replied and some did not: say so, because the uptime value
    // comes only from the regions that replied.
    const partialNote =
      !loading && !noData && unknownRegions.length > 0
        ? ` title="No data for ${unknownRegions.map((r) => i18n[`region.${r.id}`] || r.id).join(', ')}"`
        : '';

    return `
      <div class="component-status component-status--status-${status}"${partialNote}>
        <div class="component-status__header">
          <div class="component-status__name">${loading ? 'Loading...' : i18n[`component.${component!.id}`]}</div>
          <div class="component-status__status">${loading ? '' : i18n[`status.${status}`]}</div>
        </div>
        ${renderOutageBars(regions, daysSince, noData)}
        <div class="component-status__footer">
          <div class="component-status__left">${daysSince} days ago</div>
          <div class="component-status__uptime">${uptimeLabel}</div>
          <div class="component-status__right">Today</div>
        </div>
      </div>
    `;
  }

  function renderUnavailable(): string {
    return `
      <div class="components-status__unavailable">
        Component status is momentarily unavailable, because our uptime monitor
        does not reply. This says nothing about the DatoCMS services: look at
        the incidents below for the current status.
      </div>
    `;
  }

  class ComponentStatusSection extends HTMLElement {
    private tooltip: HTMLDivElement | null = null;
    private data: ComponentData[] | null = null;

    connectedCallback() {
      const days = parseInt(this.dataset.days || '60', 10);

      this.innerHTML = `
        <div class="components-status">
          <div class="components-status__title">Components Status</div>
          <div class="components-status__cards">
            ${Array.from({ length: 6 }).map(() => renderCard(null, days)).join('')}
          </div>
        </div>
      `;

      this.addEventListener('mouseover', this.handleMouseOver);
      this.addEventListener('mouseout', this.handleMouseOut);

      fetch(`/api/component-status?days=${days}`)
        .then(async (res) => {
          if (!res.ok) {
            throw new Error(`/api/component-status replied with ${res.status}`);
          }

          const data = await res.json();

          if (!Array.isArray(data)) {
            throw new Error('/api/component-status gave an unexpected reply');
          }

          return data as ComponentData[];
        })
        .then((data) => {
          this.data = data;
          this.querySelector('.components-status__cards')!.innerHTML = data
            .map((c) => renderCard(c, days))
            .join('');
        })
        .catch((error) => {
          console.error(error);
          this.data = null;
          this.querySelector('.components-status__cards')!.innerHTML =
            renderUnavailable();
        });
    }

    private handleMouseOver = (e: Event) => {
      const rect = (e.target as Element).closest('rect');
      if (!rect || !this.data) return;

      const card = rect.closest('.component-status');
      if (!card) return;

      const cards = Array.from(this.querySelectorAll('.component-status'));
      const cardIndex = cards.indexOf(card);
      const component = this.data[cardIndex];
      if (!component) return;

      const date = new Date(rect.getAttribute('data-date')!);
      const index = parseInt(rect.getAttribute('data-index')!, 10);
      const days = parseInt(this.dataset.days || '60', 10);
      const perRegion = downtimePerRegion(component.regions, date);
      const total = totalDowntime(perRegion);

      const outageContainer = card.querySelector('.daily-outage')!;
      this.removeTooltip();

      this.tooltip = document.createElement('div');
      this.tooltip.className = 'daily-outage-tooltip';
      this.tooltip.style.left = `${(index / days) * 100}%`;
      this.tooltip.innerHTML = renderTooltip(date, perRegion, total);
      outageContainer.appendChild(this.tooltip);
    };

    private handleMouseOut = (e: Event) => {
      const rect = (e.target as Element).closest('rect');
      if (rect) {
        this.removeTooltip();
      }
    };

    private removeTooltip() {
      this.tooltip?.remove();
      this.tooltip = null;
    }

    disconnectedCallback() {
      this.removeEventListener('mouseover', this.handleMouseOver);
      this.removeEventListener('mouseout', this.handleMouseOut);
    }
  }

  customElements.define('component-status-section', ComponentStatusSection);
</script>
