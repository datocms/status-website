---
import { format } from 'date-fns';
import { renderMarkdown } from '../lib/markdown';
import { timeLink } from '../lib/timeLink';
import type { Incident } from '../lib/incidents';

interface Props {
  incident: Incident;
}

const { incident } = Astro.props;
---

<div class="unresolved-incident__body">
  {incident.isMaintenance && (
    <div class="unresolved-incident__summary">
      <p class="unresolved-incident__summary__row">
        <strong>Scheduled for:</strong>{` ${format(incident.scheduledStart!, 'MMM d')}, `}
        <a href={timeLink(incident.scheduledStart!, 'Maintenance start date')}>{format(incident.scheduledStart!, 'HH:mm')}</a>
        {' - '}
        <a href={timeLink(incident.scheduledEnd!, 'Maintenance end date')}>{format(incident.scheduledEnd!, 'HH:mm')}</a>
        {` ${format(incident.scheduledEnd!, 'OOOO')}`}
      </p>
      {incident.affectedComponents.length > 0 && (
        <p class="unresolved-incident__summary__row">
          <strong>Affected components:</strong>{' '}
          {incident.affectedComponents.join(', ')}
        </p>
      )}
    </div>
  )}
  {incident.updates.map((update) => (
    <div class="unresolved-incident__update">
      <div class="unresolved-incident__update__description">
        <div class="ugc" set:html={renderMarkdown(update.contentWithStatus)} />
      </div>
      <p class="unresolved-incident__update__timestamp">
        {format(update.date, 'MMM d, HH:mm OOOO')}
      </p>
    </div>
  ))}
</div>
