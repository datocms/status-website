---
import { renderMarkdown } from '../lib/markdown';
import { timeLink } from '../lib/timeLink';
import { timeHtml, timestampHtml } from '../lib/time';
import type { Incident } from '../lib/incidents';

interface Props {
  incident: Incident;
}

const { incident } = Astro.props;
---

<div class="unresolved-incident__body">
  {incident.isMaintenance && (
    <div class="unresolved-incident__summary">
      <p class="unresolved-incident__summary__row">
        <strong>Scheduled for:</strong>{' '}
        <Fragment set:html={timeHtml('short-date', incident.scheduledStart!)} />{', '}
        <a href={timeLink(incident.scheduledStart!, 'Maintenance start date')} set:html={timeHtml('clock', incident.scheduledStart!)} />
        {' - '}
        <a href={timeLink(incident.scheduledEnd!, 'Maintenance end date')} set:html={timeHtml('clock', incident.scheduledEnd!)} />
        {' '}<Fragment set:html={timeHtml('zone', incident.scheduledStart!)} />
        <relative-time datetime={incident.scheduledStart!.toISOString()}></relative-time>
      </p>
      {incident.affectedComponents.length > 0 && (
        <p class="unresolved-incident__summary__row">
          <strong>Affected components:</strong>{' '}
          {incident.affectedComponents.join(', ')}
        </p>
      )}
    </div>
  )}
  {incident.updates.map((update) => (
    <div class="unresolved-incident__update">
      <div class="unresolved-incident__update__description">
        <div class="ugc" set:html={renderMarkdown(update.contentWithStatus)} />
      </div>
      {!update.isAnnouncement && (
        <p class="unresolved-incident__update__timestamp" set:html={timestampHtml(update.date)} />
      )}
    </div>
  ))}
</div>
