<third-party-components></third-party-components>

<script>
  import { format, isValid, parseISO } from 'date-fns';

  interface FeedItem {
    title: string;
    date: string;
    url: string;
    description: string;
    source: {
      name: string;
      homepageUrl: string;
    };
  }

  const ESCAPES: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  const escape = (value: string) =>
    value.replace(/[&<>"']/g, (character) => ESCAPES[character]);

  const message = (text: string) =>
    `<p class="incidents-daily__day__no-incidents">${text}</p>`;

  // Escaping stops attribute breakout but leaves the scheme intact, and every
  // link here comes from a supplier's API, so javascript: would still run.
  const isHttpUrl = (value: string) => {
    try {
      const { protocol } = new URL(value);
      return protocol === 'http:' || protocol === 'https:';
    } catch {
      return false;
    }
  };

  const renderItem = (item: FeedItem) => {
    const date = parseISO(item.date);
    const label = `${escape(item.source.name)}: ${escape(item.title)}`;

    return `
      <div class="incidents-daily__incident">
        <h6 class="incidents-daily__incident__title">
          ${
            isHttpUrl(item.url)
              ? `<a href="${escape(item.url)}">${label}</a>`
              : label
          }
        </h6>
        <div class="incidents-daily__incident__update__description">
          <div>${escape(item.description)}</div>
        </div>
        ${
          isValid(date)
            ? `<p class="incidents-daily__incident__update__timestamp">
          ${format(date, 'MMMM d, yyyy')}
        </p>`
            : ''
        }
      </div>
    `;
  };

  class ThirdPartyComponents extends HTMLElement {
    connectedCallback() {
      fetch('/api/feeds')
        .then((response) => {
          // The GitHub Pages fallback serves no API routes. A missing endpoint
          // is expected there, so stay out of the way rather than showing an
          // error box for the whole duration of a Netlify outage.
          if (response.status === 404) {
            return null;
          }

          if (!response.ok) {
            throw new Error(`/api/feeds returned ${response.status}`);
          }

          return response.json();
        })
        .then((feeds: FeedItem[] | null) => {
          if (feeds === null) {
            return;
          }

          this.render(
            feeds && feeds.length > 0
              ? feeds.map(renderItem).join('')
              : message('All third-party components are operational.'),
          );
        })
        .catch((error) => {
          console.error(error);
          this.render(message('Third-party status is currently unavailable.'));
        });
    }

    // Rendering nothing on an empty or failed response made a healthy section
    // and a broken one look identical, which is how a crash here stayed hidden.
    render(body: string) {
      this.innerHTML = `
        <div class="incidents-daily">
          <div class="incidents-daily__title">Third-Party Components</div>
          <div>${body}</div>
        </div>
      `;
    }
  }

  customElements.define('third-party-components', ThirdPartyComponents);
</script>
