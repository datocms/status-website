<third-party-components id="third-party-components"></third-party-components>

<script>
  import { timestampHtml } from '../lib/time';
  import { mirrorNotice } from '../lib/metricsMessage';
  import { restoreTarget, sectionLink } from '../lib/sectionAnchor';

  interface FeedItem {
    title: string;
    date: string;
    url: string;
    description: string;
    status: string;
    ongoing: boolean;
    source: {
      name: string;
      homepageUrl: string;
    };
  }

  const ESCAPES: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  const escape = (value: string) =>
    value.replace(/[&<>"']/g, (character) => ESCAPES[character]);

  const message = (text: string) =>
    `<p class="incidents-daily__day__no-incidents">${text}</p>`;

  // Escaping stops attribute breakout but leaves the scheme intact, and every
  // link here comes from a supplier's API, so javascript: would still run.
  const isHttpUrl = (value: string) => {
    try {
      const { protocol } = new URL(value);
      return protocol === 'http:' || protocol === 'https:';
    } catch {
      return false;
    }
  };

  const renderItem = (item: FeedItem) => {
    const timestamp = timestampHtml(new Date(item.date));
    const label = `${escape(item.source.name)}: ${escape(item.title)}`;

    return `
      <div class="incidents-daily__incident">
        <h4 class="incidents-daily__incident__title">
          ${
            isHttpUrl(item.url)
              ? `<a href="${escape(item.url)}">${label}</a>`
              : label
          }
        </h4>
        <div class="incidents-daily__incident__update__description">
          <div>${
            // Under a "Recently resolved" heading the status would only repeat
            // itself; for an ongoing incident it says how far along the fix is.
            item.ongoing ? `${escape(item.status)} — ` : ''
          }${escape(item.description)}</div>
        </div>
        ${
          timestamp
            ? `<p class="incidents-daily__incident__update__timestamp">${timestamp}</p>`
            : ''
        }
      </div>
    `;
  };

  const group = (title: string, body: string) => `
    <div class="incidents-daily__day">
      <h3 class="incidents-daily__day__title">${title}</h3>
      <div>${body}</div>
    </div>
  `;

  // A header fragment that is not valid percent-encoding is still a supplier
  // name to show. It must not throw the feed items away.
  const decodeName = (fragment: string) => {
    try {
      return decodeURIComponent(fragment);
    } catch {
      return fragment;
    }
  };

  // The endpoint names the suppliers that gave no reply. No item from one of
  // those does not mean that it is operational.
  const readUnreached = (response: Response) =>
    (response.headers.get('X-Unreached-Suppliers') || '')
      .split(',')
      .filter(Boolean)
      .map(decodeName);

  const unreachedNote = (unreached: string[]) =>
    unreached.length > 0
      ? message(`No status available from: ${unreached.map(escape).join(', ')}.`)
      : '';

  const renderGroups = (feeds: FeedItem[]) => {
    const ongoing = feeds.filter((item) => item.ongoing);
    const resolved = feeds.filter((item) => !item.ongoing);

    return (
      group(
        'Ongoing',
        ongoing.length > 0
          ? ongoing.map(renderItem).join('')
          : message('No ongoing incidents.'),
      ) +
      (resolved.length > 0
        ? group('Recently resolved', resolved.map(renderItem).join(''))
        : '')
    );
  };

  class ThirdPartyComponents extends HTMLElement {
    connectedCallback() {
      fetch('/api/feeds')
        .then((response) => {
          // The static mirror serves no API routes. Say so: an empty section
          // looks like a page that did not load.
          if (response.status === 404) {
            return null;
          }

          if (!response.ok) {
            throw new Error(`/api/feeds returned ${response.status}`);
          }

          return response
            .json()
            .then((feeds: FeedItem[]) => ({
              feeds,
              unreached: readUnreached(response),
            }));
        })
        .then((reply) => {
          if (reply === null) {
            this.render(mirrorNotice('Third-party status is', this.id));
            return;
          }

          const { feeds, unreached } = reply;

          if (feeds && feeds.length > 0) {
            this.render(renderGroups(feeds) + unreachedNote(unreached));
            return;
          }

          this.render(
            unreached.length > 0
              ? message('No incidents reported by the suppliers that replied.') +
                  unreachedNote(unreached)
              : message('All third-party components are operational.'),
          );
        })
        .catch((error) => {
          console.error(error);
          this.render(message('Third-party status is currently unavailable.'));
        });
    }

    // Rendering nothing on an empty or failed response made a healthy section
    // and a broken one look identical, which is how a crash here stayed hidden.
    render(body: string) {
      this.innerHTML = `
        <div class="incidents-daily">
          <h2 class="incidents-daily__title section-title">${sectionLink(this.id, 'Third-Party Components')}</h2>
          <div>${body}</div>
        </div>
      `;
      restoreTarget();
    }
  }

  customElements.define('third-party-components', ThirdPartyComponents);
</script>
