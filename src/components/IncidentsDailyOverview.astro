---
import { renderMarkdown } from '../lib/markdown';
import { ofDay, type Incident } from '../lib/incidents';
import { sectionLink } from '../lib/sectionAnchor';
import { startOfUtcDay, subUtcDays, timeHtml, timestampHtml } from '../lib/time';

interface Props {
  incidents: Incident[];
  daysCount: number;
}

const { incidents, daysCount } = Astro.props;

const days: Date[] = [];
for (let i = 0; i < daysCount; i++) {
  days.push(subUtcDays(startOfUtcDay(new Date()), i));
}
---

<div class="incidents-daily" id="incident-history">
  <h2 class="incidents-daily__title section-title" set:html={sectionLink('incident-history', 'Incident History')} />
  <p class="section-hint"><time-mode-hint>Dates &amp; times in UTC.</time-mode-hint></p>
  {days.map((day) => {
    const dayIncidents = ofDay(incidents, day);
    return (
      <div class="incidents-daily__day">
        <h3 class="incidents-daily__day__title">
          <Fragment set:html={timeHtml('day', day)} />
        </h3>
        <div>
          {dayIncidents.length === 0 ? (
            <p class="incidents-daily__day__no-incidents">
              No incidents reported.
            </p>
          ) : (
            dayIncidents.map((incident) => (
              <div
                class={`incidents-daily__incident incidents-daily__incident--impact-${incident.impact}`}
              >
                <h4 class="incidents-daily__incident__title">
                  <a href={`/incidents/${incident.slug}/`}>{incident.name}</a>
                </h4>
                {incident.updates.map((update) => (
                  <div class="incidents-daily__incident__update">
                    <div class="incidents-daily__incident__update__description">
                      <div
                        class="ugc"
                        set:html={renderMarkdown(update.contentWithStatus)}
                      />
                    </div>
                    {!update.isAnnouncement && (
                      <p class="incidents-daily__incident__update__timestamp" set:html={timestampHtml(update.date)} />
                    )}
                  </div>
                ))}
              </div>
            ))
          )}
        </div>
      </div>
    );
  })}
</div>
